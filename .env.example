# =============================================================================
# Paradox Numbers — Environment
# Copy to .env and fill every [REQUIRED] value before production.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
# production | development

# --- Supabase (REQUIRED) ---
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
# anon / public key (browser + JWT verify)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (API only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs (REQUIRED in production) ---
# Public web origin (CORS + OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public API base used by the web client
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- API server ---
API_PORT=3001
API_HOST=0.0.0.0

# --- Telecom provider ---
# mock | telnyx | twilio
TELECOM_PROVIDER=mock

# Telnyx — REQUIRED when TELECOM_PROVIDER=telnyx
TELNYX_API_KEY=
# Messaging Profile ID (Mission Control) so ordered numbers receive SMS
TELNYX_MESSAGING_PROFILE_ID=

# Twilio — REQUIRED when TELECOM_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- SMS webhook (REQUIRED in production) ---
# Shared secret providers/proxies send as header: x-webhook-secret
SMS_WEBHOOK_SECRET=change-me-in-production
# Absolute URL Twilio/Telnyx should POST inbound SMS to
SMS_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/sms

# --- Billing webhook (REQUIRED in production) ---
# Payment processor (or your Paystack worker) sends header: x-billing-secret
BILLING_WEBHOOK_SECRET=change-me-in-production

# --- Payments (optional until live checkout) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
