# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API
API_PORT=3001
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Telecom providers
TELNYX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments (server-side only)
PAYSTACK_SECRET_KEY=
# Currency used for the current USD-denominated inventory prices.
# Paystack amounts are sent in the currency's minor unit (USD cents here).
PAYSTACK_CURRENCY=USD
# Optional modern Paystack webhook signing secret (whsec_...).
# If unset, legacy x-paystack-signature verification uses PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SMS webhooks
SMS_WEBHOOK_SECRET=change-me-in-production
SMS_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/sms
