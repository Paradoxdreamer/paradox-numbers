# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API
API_PORT=3001
API_HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Telecom provider: mock | telnyx | twilio
TELECOM_PROVIDER=mock

# Telnyx (required when TELECOM_PROVIDER=telnyx)
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=

# Twilio (future)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Webhooks
SMS_WEBHOOK_SECRET=change-me-in-production
SMS_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/sms

# Billing webhook (payment provider calls this)
BILLING_WEBHOOK_SECRET=change-me-in-production
