# Supabase
# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (API uses these)
SUPABASE_URL=                 # same as NEXT_PUBLIC_SUPABASE_URL, optional alias
SUPABASE_SERVICE_ROLE_KEY=    # required for API privileged operations

# API
API_PORT=3001
API_HOST=0.0.0.0

# Providers (fill after research / compliance checks)
TELNYX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
